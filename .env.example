# Runtime
NODE_ENV=production
PORT=3000
# En Railway, monta un Volume y usa una ruta dentro de ese volumen.
PERSISTENT_DATA_DIR=./bot

# Bot owner. Use digits only, including the country code. Multiple numbers: comma-separated.
OWNER_NUMBER=18095551234
OWNER_TELEGRAM_ID=

# Dashboard administration. No default credentials are provided.
# Use long, unique values and configure them only through the deployment secret manager.
ADMIN_USERNAME=cambia_este_usuario
ADMIN_PASSWORD=cambia_esta_contrasena_larga_y_unica

# Optional Telegram integration
TELEGRAM_BOT_TOKEN=

# Optional OpenAI-compatible AI integration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1

# Optional encrypted GitHub backup. Configure all five variables together.
# The backup contains WhatsApp session data; keep this repository private and use a fine-grained,
# contents-write token limited to this repository.
GITHUB_BACKUP_TOKEN=
GITHUB_BACKUP_REPO=owner/private-backup-repository
GITHUB_BACKUP_BRANCH=main
GITHUB_BACKUP_PATH=bot/state.enc
BACKUP_ENCRYPTION_KEY=genera_una_clave_larga_aleatoria_y_unica
