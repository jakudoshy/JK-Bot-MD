# ᴊᴋ ʙᴏᴛꫂꤪꤨᴼᶠᶜ — configuración de producción
NODE_ENV=production
PORT=3000

# Identidad y vinculación
# El acceso Owner de WhatsApp está fijado exclusivamente a este número.
OWNER_NUMBER=5350898613
OWNER_TELEGRAM_ID=tu_id_de_telegram
# Enlace que usarán todos los recuadros y botones del bot.
TELEGRAM_CHANNEL_URL=https://t.me/gg_no_root
# Compatibilidad con despliegues anteriores:
WHATSAPP_CHANNEL_URL=https://t.me/gg_no_root
START_IMAGE_URL=https://i.postimg.cc/pTXKFRgQ/Gemini-Generated-Image-i9sysni9sysni9sy.jpg

# Panel administrativo
ADMIN_USERNAME=jkadmin
# Contraseña del panel administrativo
ADMIN_PASSWORD=04060120**

# IA opcional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Proveedor alternativo oficial: deepseek. No uses contraseñas del sitio web.
# AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# Proveedor recomendado para Railway.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# AI_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# AI_BASE_URL=https://api.openai.com/v1
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_SIZE=1024x1024
# OPENAI_IMAGE_QUALITY=medium

# Respaldo cifrado opcional en un repositorio privado SEPARADO (nunca uses JK-Bot-MD)
# GITHUB_BACKUP_TOKEN=ghp_tu_pat_con_contents_write
# GITHUB_BACKUP_REPO=tu-cuenta/jkbot-private-backup
# GITHUB_BACKUP_BRANCH=main
# GITHUB_BACKUP_PATH=bot/state.enc
# BACKUP_ENCRYPTION_KEY=crea_una_clave_larga_y_unica

# Telegram opcional
# TELEGRAM_BOT_TOKEN=

# Persistencia local para Railway/volumen (necesaria para sesiones y archivos)
# En Railway monta un volumen en /data y usa esta ruta; la ruta por sí sola no crea un volumen.
PERSISTENT_DATA_DIR=/data/bot

# PostgreSQL/Railway/Supabase (recomendado para TODO el estado de la web y del bot)
# En Railway enlaza la variable DATABASE_URL del servicio PostgreSQL.
# En Supabase usa la cadena privada/directa; nunca la publiques ni la pongas en el frontend.
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# POSTGRES_SSL=true  # Actívalo si tu PostgreSQL externo exige TLS (Supabase lo usa por defecto).
# SUPABASE_DB_URL=postgresql://postgres:<PASSWORD>@db.<PROJECT-REF>.supabase.co:5432/postgres?sslmode=require
# SUPABASE_DB_POOL_MAX=5
# SUPABASE_DB_SSL=true
